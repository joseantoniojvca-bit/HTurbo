sharedstatedir = @sharedstatedir@
srcdir = @srcdir@
sysconfdir = @sysconfdir@
target_alias = @target_alias@
top_build_prefix = @top_build_prefix@
top_builddir = @top_builddir@
top_srcdir = @top_srcdir@
AUTOMAKE_OPTIONS = foreign
AM_CPPFLAGS = -fpermissive -I$(srcdir)/../include \
	-I$(srcdir)/../dequad -I$(srcdir)/../bequad \
	-I$(srcdir)/../zeta -I$(srcdir)/../sandia \
	-I$(srcdir)/../sparse -I$(srcdir)/../smolpack \
	-I$(srcdir)/../dyres -I$(srcdir)/../mcfm \
	-I$(srcdir)/../as3vjet -I$(srcdir)/../resum \
	-I$(srcdir)/../counterterm -I$(srcdir)/../qt \
	-I$(srcdir)/../hpoly -I$(srcdir)/../crundec \
	-I$(srcdir)/../vjet -I$(srcdir)/../born \
	-I$(builddir)/../cubature -I$(srcdir)/../phasespace \
	-I$(srcdir)/../histo -I$(srcdir)/../user \
	-I$(srcdir)/../polylog $(HELLX_CPPFLAGS) $(HELL_CPPFLAGS) \
	$(CUBA_CPPFLAGS) $(LHAPDF_CPPFLAGS) $(CERES_CPPFLAGS) \
	$(EIGEN_CPPFLAGS) $(NEOPDF_CPPFLAGS) \
	-DSHAREDIR=\"${datadir}/${PACKAGE}\" $(am__append_5)
AM_FFLAGS = -I$(srcdir)/../dyres \
	-I$(srcdir)/../mcfm

noinst_LTLIBRARIES = libdyturbobase.la
libdyturbobase_la_SOURCES = dyturbo.C resintegr.C ctintegr.C \
	fpcintegr.C finintegr.C bornintegr.C fointegr.C omegaintegr.C \
	interface.C settings.C init.C cubacall.C switch.C pdf.C \
	coupling.C clock_real.C banner.C print_table.C abint.C \
	clenshawcurtisrules.C gaussrules.C sparserules.C propagator.C \
	numbers.C chebyshev.C codata.C scales.C taucut.C mellinpdf.C \
	constants.C psi.C dilog.C isnan.C $(am__append_1) flavreduce.f \
	gaussinit.f rescinit.f pdfmoments.f mjj.f fortranflush.f \
	AiMoments.cxx TLVUtils.cxx
lib_LTLIBRARIES = libdyturbo.la
libdyturbo_la_SOURCES = 
libdyturbo_la_LIBADD = libdyturbobase.la ../histo/libhisto.la \
	../phasespace/libphasespace.la ../integrands/libintegrands.la \
	../resum/libresum.la ../counterterm/libcounterterm.la \
	../vjet/libvjet.la ../v2j/libv2j.la ../born/libborn.la \
	../dynnlo/libdynnlo.la ../dyres/libdyres.la ../qt/libqt.la \
	../hpoly/libhpoly.la ../mcfm/libmcfm.la \
	../O3as3vj/libO3as3vj.la ../as3vjet/libas3vjet.la \
	../pegasus/libpegasus.la ../dequad/libdequad.la \
	../bequad/libbequad.la ../polylog/libpolylog.la \
	../crundec/libcrundec.la ../bessel/libbessel.la \
	../fbt/libfbt.la ../sandia/libsandia.la ../sparse/libsparse.la \
	../smolpack/libsmolpack.la ../besche/libbesche.la \
	../minprescription/libminprescription.la \
	../specialfunctions/libspecialfunctions.la \
	../cubature/libcubature.la -lgfortran $(LHAPDF_LDFLAGS) \
	-lLHAPDF $(NEOPDF_LDFLAGS) $(CUBA_LDFLAGS) $(QCDLOOP_LDFLAGS) \
	$(CHAPLIN_LDFLAGS) $(CERES_LDFLAGS) $(POLYLOG_LDFLAGS) \
	$(HELLX_LDFLAGS) $(HELL_LDFLAGS) -lquadmath -lm \
	$(am__append_2) $(am__append_3) $(am__append_4)
dyturbo_SOURCES = main.C
#dyturbo_LDADD = -Wl,-Bstatic -ldyturbo -Wl,-Bdynamic
dyturbo_LDADD = libdyturbo.la
dyturbo_LDFLAGS = -static $(NEOPDF_LDFLAGS) #-all-static #-Wl,-Bstatic
@HAVE_ROOT_TRUE@dyturbo_merger_SOURCES = merger.C
@HAVE_ROOT_TRUE@dyturbo_merger_LDADD = $(ROOT_LDFLAGS)
@HAVE_ROOT_TRUE@dyturbo_csk_SOURCES = csk.C
@HAVE_ROOT_TRUE@dyturbo_csk_LDADD = libdyturbo.la $(ROOT_LDFLAGS)
pkginclude_HEADERS = dyturbo.h resintegr.h ctintegr.h fpcintegr.h finintegr.h bornintegr.h fointegr.h omegaintegr.h \
		     interface.h settings.h cubacall.h switch.h options.f flred.f \
		     gauss.f quadrules.f coupling.h pdf.h clock_real.h \
		     fcomplex.h banner.h cxxopts.hpp isnan.h handy_typdefs.h abint.h \
		     clenshawcurtisrules.h gaussrules.h sparserules.h numbers.h parton.h AiMoments.h TLVUtils.h chebyshev.h codata.h \
		     propagator.h scales.h taucut.h mellinpdf.h constants.h cerespdf.h psi.h accel.h flush.h dilog.h  #solvew.h

all: all-am

.SUFFIXES:
.SUFFIXES: .C .cxx .f .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign src/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign src/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && rm -f $$files

clean-binPROGRAMS:
	@list='$(bin_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

install-libLTLIBRARIES: $(lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(libdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(libdir)"; \
	}

uninstall-libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(libdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(libdir)/$$f"; \
	done

clean-libLTLIBRARIES:
	-test -z "$(lib_LTLIBRARIES)" || rm -f $(lib_LTLIBRARIES)
	@list='$(lib_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

libdyturbo.la: $(libdyturbo_la_OBJECTS) $(libdyturbo_la_DEPENDENCIES) $(EXTRA_libdyturbo_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(LINK) -rpath $(libdir) $(libdyturbo_la_OBJECTS) $(libdyturbo_la_LIBADD) $(LIBS)

libdyturbobase.la: $(libdyturbobase_la_OBJECTS) $(libdyturbobase_la_DEPENDENCIES) $(EXTRA_libdyturbobase_la_DEPENDENCIES) 
	$(AM_V_CXXLD)$(CXXLINK)  $(libdyturbobase_la_OBJECTS) $(libdyturbobase_la_LIBADD) $(LIBS)

dyturbo$(EXEEXT): $(dyturbo_OBJECTS) $(dyturbo_DEPENDENCIES) $(EXTRA_dyturbo_DEPENDENCIES) 
	@rm -f dyturbo$(EXEEXT)
	$(AM_V_CXXLD)$(dyturbo_LINK) $(dyturbo_OBJECTS) $(dyturbo_LDADD) $(LIBS)

dyturbo-csk$(EXEEXT): $(dyturbo_csk_OBJECTS) $(dyturbo_csk_DEPENDENCIES) $(EXTRA_dyturbo_csk_DEPENDENCIES) 
	@rm -f dyturbo-csk$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(dyturbo_csk_OBJECTS) $(dyturbo_csk_LDADD) $(LIBS)

dyturbo-merger$(EXEEXT): $(dyturbo_merger_OBJECTS) $(dyturbo_merger_DEPENDENCIES) $(EXTRA_dyturbo_merger_DEPENDENCIES) 
	@rm -f dyturbo-merger$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(dyturbo_merger_OBJECTS) $(dyturbo_merger_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

