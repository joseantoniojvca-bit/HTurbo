	-rm -f CONVOS/tc2ga1/$(am__dirstamp)
	-rm -f CONVOS/tcgaga/$(DEPDIR)/$(am__dirstamp)
	-rm -f CONVOS/tcgaga/$(am__dirstamp)
	-rm -f CONVOS/tga1ga2/$(DEPDIR)/$(am__dirstamp)
	-rm -f CONVOS/tga1ga2/$(am__dirstamp)
	-rm -f CONVOS/tgagaga/$(DEPDIR)/$(am__dirstamp)
	-rm -f CONVOS/tgagaga/$(am__dirstamp)
	-rm -f tgamma3/$(DEPDIR)/$(am__dirstamp)
	-rm -f tgamma3/$(am__dirstamp)

